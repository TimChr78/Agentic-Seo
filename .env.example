# Copy to .env (never commit .env). `aseo init` generates the secrets for you; by hand:
#   the passwords as hex, because docker-compose.yml puts POSTGRES_PASSWORD into DATABASE_URL
#   and base64's `/` breaks it:  openssl rand -hex 32
#   the two keys as base64 (read as base64 by the server):  openssl rand -base64 32

# Docker Compose only (the app does not read these settings). ASEO_VERSION pins the released image
# so a restart or pull does not silently change versions; ASEO_PORT publishes the app on the host
# (the container still listens on 3000, so also update PUBLIC_URL when you change it). A source
# build through docker-compose.build.yml tags the local image; uncomment to choose the tag.
ASEO_VERSION=0.0.0
ASEO_PORT=3000
# ASEO_BUILD_IMAGE=agentic-seo:local

# Use a hex value (0-9a-f, no `/`, `+`, `=`, `@` or `$`): docker-compose.yml interpolates this
# password into DATABASE_URL, where a reserved character has to be percent-encoded and Compose
# cannot do that. `openssl rand -hex 32` produces one.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
# Name of the row-level-security role the app uses; default aseo_app. Roles are server-wide, so give
# each install on a shared Postgres server its own name.
# APP_DB_ROLE=aseo_app
AUTH_SECRET=
# Required with KEY_PROVIDER=local (the default); optional when OpenBao or AWS KMS holds the KEK.
MASTER_KEY=
# During a master key rotation only: the old key(s), comma-separated. Set the new MASTER_KEY, keep
# the old one here, run `aseo rotate-keys`, then remove it.
MASTER_KEY_PREVIOUS=
# CLI only (not server configuration): `aseo bootstrap` and `aseo reset-password` read the password
# from these when set, otherwise they prompt without echo or read one line from stdin.
# ASEO_BOOTSTRAP_PASSWORD=
# ASEO_RESET_PASSWORD=
# The commit the image was built from, shown by `aseo version` and /healthz.
# ASEO_GIT_SHA=

# Public URL of the server. MCP (AI agents) requires HTTPS here: with a plain-HTTP address other
# than loopback (for development) the admin UI and REST API still work, but the MCP/OAuth client
# endpoints are disabled.
PUBLIC_URL=http://localhost:3000
# Directory with the built admin UI. The image includes apps/web/dist and serves it at `/`; set this
# to serve a different build (e.g. a mounted volume). Empty: apps/web/dist in the repo/image.
WEB_DIST=
# Client IP headers in trust order, comma-separated. Public traffic through a Cloudflare Tunnel
# sends cf-connecting-ip; admin/sign-in traffic on the LAN or VPN has no forwarding header and
# falls back to the socket address.
CLIENT_IP_HEADER=cf-connecting-ip,x-forwarded-for
# Comma-separated proxy or loopback ranges whose forwarding headers are trusted, e.g. the tunnel
# or reverse proxy. Multi-value headers such as x-forwarded-for are read from right to left:
# addresses in these ranges are skipped, so an appending proxy's real client wins over a value the
# client prepended. Empty ignores forwarding headers and uses the socket address, so set this to
# your proxy/loopback ranges whenever a proxy sits in front (per-IP limits otherwise see the proxy).
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,10.0.0.0/8
# Reject unknown command input keys with invalid_input instead of the default warn-first behaviour,
# where they are logged and returned in the result's warnings. Roll out with false, fix clients, then set true.
STRICT_INPUTS=false
# MCP tool result text: json (full result; default) or summary (one line, e.g. "agents.list: 3 agents").
# structuredContent always carries the full result.
MCP_TEXT_CONTENT=json
# MCP tool names: dotted command names such as agents.list (default), or underscore names such as
# agents_list for clients that do not accept dots.
MCP_TOOL_NAME_STYLE=dotted
# Where the key-encryption key lives: local (MASTER_KEY), openbao or aws-kms.
KEY_PROVIDER=local
# OpenBao/Vault Transit. The token can be given inline or in a file written by an agent or a
# projected Secret; prefer the file in Kubernetes. Mount is the Transit mount (default transit),
# key is the Transit key (default agentic-seo), namespace is the Vault Enterprise namespace.
# OPENBAO_ADDR=https://bao.internal:8200
# OPENBAO_TOKEN=
# OPENBAO_TOKEN_FILE=/vault/secrets/token
# OPENBAO_TRANSIT_MOUNT=transit
# OPENBAO_TRANSIT_KEY=agentic-seo
# OPENBAO_NAMESPACE=
# AWS KMS: key id/alias, region, static or session credentials, and an optional VPC endpoint
# (default kms.<region>.amazonaws.com).
# AWS_KMS_KEY_ID=alias/agentic-seo
# AWS_REGION=eu-north-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_KMS_ENDPOINT=
# Optional: send traces to any OTLP collector, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Server log level for the pino logger: fatal, error, warn, info (default), debug, trace or silent.
# LOG_LEVEL=info
# Prometheus metrics at GET /metrics on the main listener. The endpoint is disabled and answers 404
# until this bearer token is set; scrape with `Authorization: Bearer $METRICS_TOKEN`.
# Generate one with `openssl rand -hex 24`.
# METRICS_TOKEN=
# Roles a process runs: api, worker, scheduler, or all (the Compose default).
# ROLE=all
# PORT=3000
# Start without migrating (Kubernetes: a migration job runs before each upgrade).
# SKIP_MIGRATIONS=false
# Graphile Worker: how many jobs a worker runs at once, how often it polls, and how often the
# scheduler enqueues recurring work (Phase 0 has no jobs yet).
# WORKER_CONCURRENCY=5
# WORKER_POLL_INTERVAL_MS=2000
# JOB_TICK_MS=60000

# For local development without Docker (pnpm dev), point DATABASE_URL at your Postgres, and allow
# the web dev server (pnpm dev:web) to sign in through its proxy. The password in this URL must be
# percent-encoded (`/` as `%2F`, `@` as `%40`) or hex, because it is parsed as a URL here:
DATABASE_URL=postgres://aseo:change-me@localhost:5432/aseo
TRUSTED_ORIGINS=http://localhost:5173
