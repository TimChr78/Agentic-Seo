{
  "name": "agentic-seo",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "pnpm --filter @agentic-seo/web dev",
    "build:web": "pnpm --filter @agentic-seo/web build",
    "lint": "biome check . && node scripts/changelog.mjs check",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --filter './packages/*' --filter './apps/*' typecheck",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "cli": "pnpm --filter @agentic-seo/server cli",
    "migrate": "pnpm --filter @agentic-seo/server cli migrate",
    "dev": "pnpm --filter @agentic-seo/server dev"
  },
  "pnpm": {
    "overrides": {
      "@better-auth/oauth-provider": "1.7.7",
      "@better-auth/core": "1.7.7",
      "better-auth": "1.7.7"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
